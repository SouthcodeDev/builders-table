# SETUP.md Step 10 — real values go in Vercel AND .env.local. Missing production
# vars are the classic Friday-evening outage.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: a Mapbox Studio style URL matching the Places palette.
# Falls back to mapbox://styles/mapbox/streets-v12 when empty.
NEXT_PUBLIC_MAPBOX_STYLE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: pin the clock for rehearsal (ISO string, e.g. 2026-09-19T17:30:00+02:00).
# Leave empty in production — events must stay relative to now.
NEXT_PUBLIC_DEMO_NOW=
